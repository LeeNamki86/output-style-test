# ===== 운영체제가 자동으로 만드는 파일 =====
# Windows 탐색기가 만드는 썸네일 캐시
Thumbs.db
desktop.ini
# macOS Finder가 만드는 폴더 정보 파일
.DS_Store

# ===== 에디터/IDE 설정 폴더 =====
.vscode/
.idea/
*.swp

# ===== Claude Code 개인 설정 =====
# 내 컴퓨터에서만 쓰는 권한 설정이라 공유하지 않음
.claude/settings.local.json

# ===== 의존성 / 빌드 결과물 (나중에 생길 경우 대비) =====
node_modules/
dist/
build/

# ===== 로그 및 환경 변수 파일 =====
*.log
.env
.env.*
